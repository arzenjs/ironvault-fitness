# ---------------------------------------------------------------------------
# IronVault Fitness — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# MongoDB connection string (Atlas or a local mongod).
MONGODB_URI=mongodb://127.0.0.1:27017/ironvault

# Auth.js secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-long-random-string

# Canonical URL of the app. Required in production deployments.
# On localhost you can omit it (Auth.js infers the origin).
AUTH_URL=http://localhost:3000

# Auth.js trusts the incoming host header. Keep true behind a proxy/Vercel,
# it is only required when AUTH_URL is not set.
AUTH_TRUST_HOST=true

# Razorpay test-mode API keys (Dashboard → Settings → API Keys).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret

# Razorpay webhook signing secret (Dashboard → Settings → Webhooks).
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# Resend transactional email. Leave RESEND_API_KEY empty to disable sending:
# the app logs a warning and still completes the purchase.
RESEND_API_KEY=
RESEND_FROM_EMAIL="IronVault Fitness <memberships@ironvault.example>"

# Internal inbox that receives contact-form notifications.
CONTACT_INBOX_EMAIL=hello@ironvault.example
